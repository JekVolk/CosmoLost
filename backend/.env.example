# Django Security & Core Settings
DJANGO_SECRET_KEY=django-insecure-m!6m4)xc#03dcyfoymebe8gw=_b-5%csol^7hpdhoxlf))8o58
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite for local development; PostgreSQL in prod)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cosmolost

# NASA API Multi-Token Pool (Comma-separated keys without spaces)
# Get free keys at: https://api.nasa.gov
NASA_API_KEYS=DEMO_KEY,xK9mP2Lq8Vw1Z5tY0uR3eA4sD6fG7hJ8,zQ1wX2eC3vB4nN5mM6lK7jH8gF9dD0sA

# NASA API Base URLs
NASA_API_BASE_URL=https://api.nasa.gov
NASA_IMAGES_API_URL=https://images-api.nasa.gov

# Periodic Sync Interval in seconds (default: 3600 = 1 hour)
NASA_SYNC_INTERVAL_SEC=3600

# Rate Limiting & Networking
NASA_RATE_LIMIT_DELAY=0.25
NASA_REQUEST_TIMEOUT=15
NASA_MAX_RETRIES=3

# Safe Fallback Mode (True = graceful fallback to curated seeds; False = raise on network error)
NASA_ENABLE_MOCK_FALLBACK=True

# Redis Connection (Optional: used for distributed hash ledger & state store)
# If omitted or Redis is down, automatically falls back to local 'loader_sync_state.json'
REDIS_URL=redis://localhost:6379/1
