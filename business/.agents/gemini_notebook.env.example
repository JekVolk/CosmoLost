# Gemini Notebook API Configuration
# Get token via: gcloud auth application-default print-access-token
# Or via Google Cloud Console OAuth 2.0 Playground with scope: https://www.googleapis.com/auth/notebook

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GEMINI_NOTEBOOK_ACCESS_TOKEN=your-oauth-access-token

# Optional: Path to Service Account JSON key if using service account
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json
