                {
                  "type": "text",
                  "id": "hvb2d",
                  "name": "About Paragraph 1",
                  "fill": "#CBD5E1",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Opportunity was engineered as a mobile robotic field geologist equipped to read ancient environmental conditions locked in Martian bedrock. Its 6-wheel rocker-bogie suspension system allowed it to scale rocky slopes and cross sand drifts across 45.16 kilometers of uncharted territory.",
                  "lineHeight": 1.3,
                  "fontFamily": "Inter",
                  "fontSize": 10.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Nok3r",
                  "name": "About Paragraph 2",
                  "fill": "#94A3B8",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Powered by 1.3 square meters of triple-junction solar panels generating up to 140 watts, Opportunity's life was repeatedly extended by fortuitous Martian dust devils that swept accumulated dust from its photovoltaic arrays.",
                  "lineHeight": 1.3,
                  "fontFamily": "Inter",
                  "fontSize": 10.5,
                  "fontWeight": "normal"
                }
              ]
            },
