                      "fontSize": 15,
                      "fontWeight": "800"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "OUQrR",
                  "name": "Body",
                  "fill": "#8FA2B8",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Over 180 artificial spacecraft, landers, rovers, and rocket stages rest on the Moon and Mars. Exposed to continuous micrometeoroid bombardment, harsh thermal swings (-130°C to +120°C), and electrostatic regolith dust, these historical sentinels are steadily deteriorating. With new crewed Artemis landings and commercial robotic missions multiplying, historic sites face accidental plume blast damage without clear spatial preservation boundaries.",
                  "lineHeight": 1.4,
                  "fontFamily": "Inter",
                  "fontSize": 11.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "c8SMY",
                  "name": "Footer Badge",
                  "fill": "#FF9D3514",
                  "cornerRadius": 6,
                  "stroke": "#FF9D3540",
                  "strokeWidth": 1,
                  "gap": 6,
                  "padding": [
                    4,
                    10
                  ],
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "zghnI",
                      "name": "Text",
                      "fill": "#FF9D35",
                      "content": "PROBLEM: ACCIDENTAL DISTURBANCE & PHYSICAL DEGRADATION",
                      "fontFamily": "Inter",
                      "fontSize": 9.5,
                      "fontWeight": "700",
                      "letterSpacing": 0.6
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "xx1CT",
              "name": "Problem Card 2 (Fragmented Data)",
              "width": 688,
              "height": "fill_container",
              "fill": "#101A2AF5",
              "cornerRadius": 12,
              "stroke": "#1B2A42",
              "strokeWidth": 1,
              "layout": "vertical",
              "padding": [
                18,
                22
              ],
              "justifyContent": "space_between",
              "children": [
                {
                  "type": "frame",
                  "id": "Q6njx6",
                  "name": "Head",
                  "gap": 10,
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "LeXa3",
                      "name": "Database",
                      "width": 18,
                      "height": 18,
                      "icon": "database",
                      "library": "lucide",
                      "fill": "#00D9F5"
                    },
                    {
                      "type": "text",
                      "id": "mnk88",
                      "name": "Title",
                      "fill": "#EAF2FF",
                      "content": "Fragmented & Inaccessible Scientific Archives",
                      "fontFamily": "Inter",
                      "fontSize": 15,
                      "fontWeight": "800"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "A0SFsG",
                  "name": "Body",
                  "fill": "#8FA2B8",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Decades of lunar and Martian mission records remain scattered across disparate archives: NSSDCA text files, NASA Planetary Data System (PDS) raw binary volumes, JPL Horizons ephemerides, and university server silos. Crucial telemetry, landing coordinates, and scientific instrument histories are rarely connected into a coherent, interactive geospatial experience for researchers, students, and citizens.",
                  "lineHeight": 1.4,
                  "fontFamily": "Inter",
                  "fontSize": 11.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "t42oS6",
                  "name": "Footer Badge",
                  "fill": "#00D9F514",
                  "cornerRadius": 6,
                  "stroke": "#00D9F540",
                  "strokeWidth": 1,
                  "gap": 6,
                  "padding": [
                    4,
                    10
                  ],
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "twOe8",
                      "name": "Text",
                      "fill": "#00D9F5",
                      "content": "SOLUTION: UNIFIED 3D TELEMETRY & HARDWARE CATALOG",
                      "fontFamily": "Inter",
                      "fontSize": 9.5,
                      "fontWeight": "700",
                      "letterSpacing": 0.6
                    }
                  ]
                }
              ]
            }
          ]
