# CosmoLost Desktop Environment Configuration

# Application Metadata
VITE_APP_NAME="CosmoLost Desktop"
VITE_APP_VERSION="0.1.0"
VITE_APP_IDENTIFIER="com.cosmolost.desktop"

# API & Remote Endpoints
VITE_API_BASE_URL="http://localhost:3000/api"
VITE_API_TIMEOUT_MS=15000

# Model Context Protocol (MCP) Configuration
VITE_MCP_AUTO_CONNECT=true
VITE_MCP_DEFAULT_TRANSPORT="ipc"
VITE_MCP_PING_INTERVAL_MS=30000

# Diagnostics & Logging
VITE_ENABLE_DIAGNOSTICS=true
VITE_LOG_LEVEL="info"
