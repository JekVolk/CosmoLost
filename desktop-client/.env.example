# ==============================================================================
# CosmoLost Desktop Environment Configuration (.env.example)
#
# 🔒 ZERO-TRUST & BRING YOUR OWN KEY (BYOK) SECURITY NOTICE:
# DO NOT hardcode or bake production API keys, bot tokens, or client secrets
# into this file or distribution builds!
#
# Each user manages their own credentials securely:
# 1. Through the Settings UI (stored locally in OS Keychain / Tauri secure store)
# 2. Or automatically via local CLI tools (Antigravity CLI `agy`, Claude Code CLI `claude`)
# 3. Or using Zero-API Fallback (direct offline rendering & manual export)
# ==============================================================================

# Application Metadata
VITE_APP_NAME="CosmoLost Desktop"
VITE_APP_VERSION="0.3.1"
VITE_APP_IDENTIFIER="com.cosmolost.desktop"

# API & Remote Endpoints
VITE_API_BASE_URL="http://localhost:8000"
VITE_API_TIMEOUT_MS=15000

# Model Context Protocol (MCP) Configuration
VITE_MCP_AUTO_CONNECT=true
VITE_MCP_DEFAULT_TRANSPORT="ipc"
VITE_MCP_PING_INTERVAL_MS=30000

# Diagnostics & Logging
VITE_ENABLE_DIAGNOSTICS=true
VITE_LOG_LEVEL="info"

# ==============================================================================
# YouTube Shorts API & Google Cloud OAuth PKCE (Optional Client-Side Fallback)
# Configured by user in Settings or via docs/YOUTUBE_OAUTH_SETUP.md
# ==============================================================================
VITE_YOUTUBE_CLIENT_ID=""
VITE_YOUTUBE_CLIENT_SECRET=""

# ==============================================================================
# Telegram Bot API (Configured by user in Settings -> Social Integrations)
# ==============================================================================
VITE_TELEGRAM_BOT_TOKEN=""
VITE_TELEGRAM_CHAT_ID="@cosmolost_hq"

# ==============================================================================
# Local-First & Portal Cloud Synchronization
# ==============================================================================
VITE_ENABLE_BACKGROUND_PORTAL_SYNC=false
VITE_PORTAL_SYNC_INTERVAL_MINUTES=10
